+package com.projetok.prototype.rpg;
+import com.projetok.rpg.*;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+class CorujaoHudTest {
+    @Test void cooldownStaminaAndLowHpFollowWorldAndPersistedValues() {
+        var w=new RpgWorld();var v=RpgCombatStatus.from(w.snapshot());assertEquals(1000,v.stamina());assertTrue(v.abilityReady());
+        assertTrue(w.castAbility());v=RpgCombatStatus.from(w.snapshot());assertEquals(750,v.stamina());assertEquals(90,v.abilityTicks());assertFalse(v.abilityReady());
+        assertEquals("3.0 s",RpgCombatStatus.cooldown(v.abilityTicks()));
+        assertEquals(v,RpgCombatStatus.from(RpgWorld.restore(w.save()).snapshot()));
+        w.receiveDamage(110);assertTrue(RpgCombatStatus.from(w.snapshot()).lowHp());
+        w.receiveDamage(10000);v=RpgCombatStatus.from(w.snapshot());assertEquals(0,v.hp());assertFalse(v.abilityReady());assertFalse(v.lowHp());
+    }
+    @Test void mysticFullHealthIsUnavailableAndCooldownNeverNegative() {
+        var w=new RpgWorld(CharacterIdentity.create("Teste","mystic","azure"));assertFalse(RpgCombatStatus.from(w.snapshot()).abilityReady());
+        w.receiveDamage(10);assertTrue(RpgCombatStatus.from(w.snapshot()).abilityReady());assertEquals("Pronto",RpgCombatStatus.cooldown(-1));
+    }
+}
--- before/server/src/main/java/com/projetok/prototype/rpg/RpgCombatStatus.java
+++ after/server/src/main/java/com/projetok/prototype/rpg/RpgCombatStatus.java
@@ -0,0 +1,20 @@
+package com.projetok.prototype.rpg;
+import com.projetok.rpg.*;
+import java.util.Locale;
+
+/** Modelo puro do HUD, calculado dos valores publicados pelo mundo. */
+public record RpgCombatStatus(int hp,int maxHp,int stamina,long attackTicks,long abilityTicks,boolean abilityReady,boolean lowHp) {
+    /** Le valores de save existentes; nao cria selecao de alvo nem recursos paralelos. */
+    public static RpgCombatStatus from(RpgWorld.View v) {
+        int stamina=(int)value(v,"stamina",1000);long attack=Math.max(0,value(v,"attack-until",0)-v.ticks());
+        long ability=Math.max(0,value(v,"ability-until",0)-v.ticks());var definition=Archetypes.get(v.identity().archetype());
+        return new RpgCombatStatus(v.state().hp(),v.maxHp(),stamina,attack,ability,
+            v.state().hp()>0&&ability==0&&stamina>=definition.cost()*10&&(!definition.ability().equals("mend")||v.state().hp()<v.maxHp()),
+            v.state().hp()>0&&v.state().hp()*4<=v.maxHp());
+    }
+    private static long value(RpgWorld.View v,String prefix,long fallback){return v.state().flags().stream().filter(f->f.startsWith(prefix+":" )).mapToLong(f->Long.parseLong(f.substring(prefix.length()+1))).findFirst().orElse(fallback);}
+    /** Duracao restante arredondada para decimos; usa 30 ticks por segundo. */
+    public static String cooldown(long ticks){return ticks<=0?"Pronto":String.format(Locale.ROOT,"%.1f s",ticks/30.0);}
+    /** Resumo curto para janelas pequenas. */
+    public String text(){return "Golpe: "+cooldown(attackTicks)+" | Habilidade: "+cooldown(abilityTicks)+(abilityReady?"":" (indisponivel)")+(lowHp?" | HP BAIXO":"");}
+}
