@@ -0,0 +1,28 @@
+package com.projetok.prototype.rpg;
+import com.projetok.rpg.*;
+import java.awt.*;
+import java.awt.geom.Path2D;
+import java.awt.geom.Rectangle2D;
+
+/** Aviso pontilhado provisorio com oclusao real; cache evita recalcular por repaint. */
+public final class RpgBossOverlay {
+    private RpgBossThreat threat;
+    private Path2D.Float dots=new Path2D.Float();
+    private String key="";
+    /** Atualiza o tempo a cada snapshot e a geometria apenas quando necessario. */
+    public void update(RpgWorld.View view) {
+        threat=view.enemies().stream().filter(e->e.boss()&&e.hp()>0).map(EnemyService.View::threat).filter(java.util.Objects::nonNull).findFirst().orElse(null);
+        if(threat==null){key="";dots=new Path2D.Float();return;}
+        String next=threat.x()+":"+threat.y()+":"+threat.radius();if(key.equals(next))return;key=next;dots=new Path2D.Float();
+        int radius=threat.radius(),cx=Math.round(threat.x()),cy=Math.round(threat.y());
+        for(int y=cy-radius;y<=cy+radius;y+=6)for(int x=cx-radius;x<=cx+radius;x+=6)
+            if(threat.contains(x,y)&&threat.contains(x+1,y)&&threat.contains(x,y+1)&&threat.contains(x+1,y+1))dots.append(new Rectangle2D.Float(x,y,2,2),false);
+    }
+    /** Mostra preparacao e alcance ocluido, sem conceder dano nem alterar IA. */
+    public void draw(Graphics2D original) {
+        if(threat==null)return;Graphics2D g=(Graphics2D)original.create();
+        try {g.setColor(new Color(255,180,65,180));g.fill(dots);g.setColor(new Color(255,210,100));
+            g.setFont(new Font("SansSerif",Font.BOLD,13));g.drawString("Preparando "+RpgCombatStatus.cooldown(threat.remainingTicks()),threat.x()-60,threat.y()-threat.radius()-10);
+        } finally {g.dispose();}
+    }
+}
diff --git a/game-src/com/projetok/prototype/rpg/RpgCombatFeedback.java b/game-src/com/projetok/prototype/rpg/RpgCombatFeedback.java
new file mode 100644
index 0000000..2ae9a19
--- /dev/null
+++ b/game-src/com/projetok/prototype/rpg/RpgCombatFeedback.java
@@ -0,0 +1,40 @@
+package com.projetok.prototype.rpg;
+
+import com.projetok.rpg.*;
+import java.awt.*;
+import java.util.*;
+
+/** Efeitos provisórios limitados, derivados de eventos reais e independentes do repaint. */
+public final class RpgCombatFeedback {
+    private final java.util.List<RpgCombatEvent> active=new ArrayList<>();
+    private long sequence,tick=-1;
+    private String region="";
+    /** Consome cada sequencia uma vez; ignora eventos antigos e limpa transicoes. */
+    public void update(RpgWorld.View view) {
+        if(tick>=0&&(view.ticks()<tick||!region.equals(view.state().region()))) {
+            active.clear();sequence=view.events().stream().mapToLong(RpgCombatEvent::sequence).max().orElse(0);
+        }
+        tick=view.ticks();region=view.state().region();
+        for(var event:view.events())if(event.sequence()>sequence) {
+            sequence=event.sequence();if(tick-event.tick()<30)active.add(event);
+        }
+        active.removeIf(e->tick-e.tick()>=30);
+        while(active.size()>64)active.remove(0);
+    }
+    /** Copia imutavel para validacao e apresentacao. */
+    public java.util.List<RpgCombatEvent> active(){return java.util.List.copyOf(active);}
+    /** Desenha somente feedback; nao acessa nem altera o mundo. */
+    public void draw(Graphics2D original) {
+        Graphics2D g=(Graphics2D)original.create();
+        try {
+            g.setFont(new Font("SansSerif",Font.BOLD,14));
+            for(var e:active) {
+                int age=(int)(tick-e.tick()),x=Math.round(e.x()),y=Math.round(e.y());
+                g.setColor(e.kind()==RpgCombatEvent.Kind.HEAL?new Color(90,240,150):e.kind()==RpgCombatEvent.Kind.REJECT?new Color(230,210,150):new Color(255,120,105));
+                String text=switch(e.kind()){case HIT->"-"+e.amount();case HEAL->"+"+e.amount();case KO->"Derrotado";case REJECT->"Indisponivel";case ATTACK->"";};
+                if(!text.isEmpty())g.drawString(text,x-12,y-50-age);
+                if(age<6&&e.kind()==RpgCombatEvent.Kind.HIT){g.setStroke(new BasicStroke(2));g.drawOval(x-24,y-24,48,48);}
+            }
+        } finally {g.dispose();}
+    }
+}
