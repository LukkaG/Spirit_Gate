+final class SpawnTools {
+    SpawnTools(WorldStudio ui){ui.action("Entidades","Configurar encontro selecionado",()->{var e=ui.document.elements().stream().filter(v->ui.canvas.selected.contains(v.id())&&v.kind()==WorldDocument.Kind.ENEMY).findFirst().orElseThrow(()->new IllegalArgumentException("Selecione marcador ENEMY"));EditorOperations.editable(ui.document,e.layer());if(e.locked())throw new IllegalArgumentException("Spawn bloqueado");JPanel form=new JPanel(new GridLayout(0,2));JComboBox<String> enemy=new JComboBox<>(StudioContent.references(WorldDocument.Kind.ENEMY).toArray(String[]::new));enemy.setSelectedItem(e.reference());form.add(new JLabel("Inimigo existente"));form.add(enemy);String[] labels={"X","Y","Largura da area","Altura da area","Quantidade / limite simultaneo"};int[] values={e.x(),e.y(),e.width(),e.height(),SpawnAreas.quantity(e)};JSpinner[] f=new JSpinner[5];for(int i=0;i<5;i++){f[i]=new JSpinner(new SpinnerNumberModel(values[i],i<2?0:1,i==4?64:8192,1));form.add(new JLabel(labels[i]));form.add(f[i]);}form.add(new JLabel("Ativacao / respawn"));form.add(new JLabel("Originais (boss exige desbloqueio existente)"));if(JOptionPane.showConfirmDialog(ui,form,"Encontro: "+ui.document.region(),JOptionPane.OK_CANCEL_OPTION)!=JOptionPane.OK_OPTION)return;var p=new HashMap<>(e.properties());p.put("spawn.quantity",f[4].getValue().toString());p.put("spawn.limit",f[4].getValue().toString());p.put("spawn.activation","builtin");p.put("spawn.respawn","builtin");var n=new WorldDocument.Element(e.id(),e.kind(),e.asset(),e.sha(),e.crop(),(int)f[0].getValue(),(int)f[1].getValue(),(int)f[2].getValue(),(int)f[3].getValue(),e.layer(),e.visible(),e.locked(),(String)enemy.getSelectedItem(),e.direction(),p);StudioContent.validate(n,ui.document.region());var next=ui.document.withElements(ui.document.elements().stream().map(v->v.id().equals(e.id())?n:v).toList());SpawnAreas.points(next,n);ui.change(next);});}
+}
