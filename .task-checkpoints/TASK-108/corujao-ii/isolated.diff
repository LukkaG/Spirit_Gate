+        var e=ui.document.elements().stream().filter(v->ui.canvas.selected.contains(v.id())&&v.kind()==WorldDocument.Kind.NPC).findFirst().orElseThrow(()->new IllegalArgumentException("Selecione um NPC"));EditorOperations.editable(ui.document,e.layer());if(e.locked())throw new IllegalArgumentException("NPC bloqueado");
+        JTextField query=new JTextField(e.reference()),name=new JTextField(e.properties().getOrDefault("npc.name",RpgContent.builtin().get("npc",e.reference()).name()));JComboBox<String> ids=new JComboBox<>(StudioContent.references(WorldDocument.Kind.NPC).toArray(String[]::new));ids.setSelectedItem(e.reference());query.addActionListener(ev->{ids.removeAllItems();StudioContent.references(WorldDocument.Kind.NPC).stream().filter(id->id.contains(query.getText().trim())||RpgContent.builtin().get("npc",id).name().toLowerCase(Locale.ROOT).contains(query.getText().toLowerCase(Locale.ROOT))).forEach(ids::addItem);});
+        JComboBox<String> dialogue=new JComboBox<>(new DialogueService().ids().stream().sorted().toArray(String[]::new));dialogue.setSelectedItem(e.properties().getOrDefault("npc.dialogue",e.reference()+".start"));JComboBox<String> quest=new JComboBox<>();quest.addItem("");RpgContent.builtin().all("quest").forEach(q->quest.addItem(q.id()));quest.setSelectedItem(e.properties().getOrDefault("npc.quest",""));JComboBox<String> dir=new JComboBox<>(new String[]{"FRONT","BACK","LEFT","RIGHT"});dir.setSelectedItem(e.direction());JSpinner x=new JSpinner(new SpinnerNumberModel(e.x(),0,8192,1)),y=new JSpinner(new SpinnerNumberModel(e.y(),0,8192,1));JCheckBox sprite=new JCheckBox("Aplicar sprite selecionada na biblioteca");
+        JPanel f=new JPanel(new GridLayout(0,2,4,4));Object[][] fields={{"Buscar ID/nome (Enter)",query},{"NPC real",ids},{"Nome exibido",name},{"X",x},{"Y",y},{"Orientacao (sem espelhar)",dir},{"Dialogo do proprio NPC",dialogue},{"Missao associada (referencia)",quest},{"Interacao cadastrada",new JLabel("dialogue")},{"Aparencia",sprite}};for(var row:fields){f.add(new JLabel((String)row[0]));f.add((Component)row[1]);}if(JOptionPane.showConfirmDialog(ui,f,"NPC existente",JOptionPane.OK_CANCEL_OPTION)!=JOptionPane.OK_OPTION)return;
+        var p=new HashMap<>(e.properties());p.put("npc.name",name.getText());p.put("npc.dialogue",(String)dialogue.getSelectedItem());p.put("npc.quest",(String)quest.getSelectedItem());p.put("npc.interaction","dialogue");boolean image=sprite.isSelected()&&ui.brush!=null;var n=new WorldDocument.Element(e.id(),e.kind(),image?ui.brush.id():e.asset(),image?ui.brush.sha():e.sha(),image?ui.brushCrop:e.crop(),(int)x.getValue(),(int)y.getValue(),e.width(),e.height(),e.layer(),e.visible(),e.locked(),(String)ids.getSelectedItem(),(String)dir.getSelectedItem(),p);StudioContent.validate(n,ui.document.region());NpcEditing.validate(n);ui.change(ui.document.withElements(ui.document.elements().stream().map(v->v.id().equals(e.id())?n:v).toList()));ui.warmImages();
+    });}
+}
