+    void edit(WorldDocument.Portal old){JPanel form=new JPanel(new GridLayout(0,2));String[] labels={"ID","Origem X","Origem Y","Mapa destino (ID)","Chegada X","Chegada Y","Missao aceita (opcional)","Orientacao"};String[] defaults=old==null?new String[]{EditorOperations.id(),""+Math.max(18,ui.lastCursor.x),""+Math.max(18,ui.lastCursor.y),ui.document.id(),"140","320","","FRONT"}:new String[]{old.id(),""+old.x(),""+old.y(),old.destination(),""+old.arrivalX(),""+old.arrivalY(),old.quest(),old.direction()};JTextField[] f=new JTextField[8];for(int i=0;i<8;i++){form.add(new JLabel(labels[i]));f[i]=new JTextField(defaults[i]);form.add(f[i]);}if(JOptionPane.showConfirmDialog(ui,form,"Portal",JOptionPane.OK_CANCEL_OPTION)!=JOptionPane.OK_OPTION)return;
