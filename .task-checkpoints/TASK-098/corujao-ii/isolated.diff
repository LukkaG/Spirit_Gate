+    void graph(){var maps=ui.maps();var ids=new ArrayList<>(maps.keySet());Collections.sort(ids);JPanel panel=new JPanel(){protected void paintComponent(Graphics original){super.paintComponent(original);Graphics2D g=(Graphics2D)original.create();try{Map<String,Point> points=new HashMap<>();for(int i=0;i<ids.size();i++)points.put(ids.get(i),new Point(30+i%3*190,40+i/3*90));g.setColor(Color.GRAY);for(var d:maps.values())for(var p:d.portals())if(points.containsKey(p.destination())){Point a=points.get(d.id()),b=points.get(p.destination());g.drawLine(a.x+70,a.y+20,b.x+70,b.y+20);}for(String id:ids){Point p=points.get(id);g.setColor(new Color(55,100,95));g.fillRoundRect(p.x,p.y,150,40,10,10);g.setColor(Color.WHITE);g.drawString(id,p.x+8,p.y+24);}}finally{g.dispose();}}};panel.setPreferredSize(new Dimension(620,Math.max(220,((ids.size()+2)/3)*90+60)));JPanel all=new JPanel(new BorderLayout());all.add(new JScrollPane(panel));JTextArea errors=new JTextArea(String.join("\n",PortalGraph.validate(maps).stream().map(Object::toString).toList()),5,60);errors.setEditable(false);all.add(new JScrollPane(errors),BorderLayout.SOUTH);JOptionPane.showMessageDialog(ui,all,"Conexoes: linhas nao substituem validacao",JOptionPane.PLAIN_MESSAGE);}
