+/** Biblioteca local de modelos independentes com miniatura, duplicacao e edicao. */
+final class PrefabTools {
+    final WorldStudio ui;final Path folder;
+    PrefabTools(WorldStudio ui){this.ui=ui;folder=ui.project.resolve("studio-projects/prefabs");ui.action("Prefabs","Criar da selecao",this::save);for(String name:new String[]{"Inserir","Editar","Duplicar"})ui.action("Prefabs",name+" prefab",()->browse(name));}
