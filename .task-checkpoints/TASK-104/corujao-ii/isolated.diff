+package com.projetok.studio;
+import java.awt.*;
+import java.awt.image.BufferedImage;
+import java.util.*;
+
+/** Prefabs relativos preservam referencias, propriedades, camadas e colisao. */
+public final class Prefabs {
+    private Prefabs(){}
+    /** Captura selecao e colisao associada por intersecao ou selecao explicita. */
+    public static WorldDocument capture(WorldDocument d,Set<String> selection,String id){var elements=d.elements().stream().filter(e->selection.contains(e.id())).toList();if(elements.isEmpty()||elements.size()>4096)throw new IllegalArgumentException("Selecione 1 a 4096 elementos");Rectangle bounds=new Rectangle(elements.get(0).x(),elements.get(0).y(),elements.get(0).width(),elements.get(0).height());for(var e:elements)bounds.add(new Rectangle(e.x(),e.y(),e.width(),e.height()));Rectangle visual=new Rectangle(bounds);var boxes=d.hitboxes().stream().filter(h->selection.contains(h.id())||visual.intersects(h.x(),h.y(),h.width(),h.height())).toList();for(var h:boxes)bounds.add(new Rectangle(h.x(),h.y(),h.width(),h.height()));final int x=bounds.x,y=bounds.y;return new WorldDocument(1,id,id,d.region(),Math.max(32,bounds.width),Math.max(32,bounds.height),d.grid(),d.layers(),elements.stream().map(e->e.at(e.id(),e.x()-x,e.y()-y)).toList(),boxes.stream().map(h->new WorldDocument.Hitbox(h.id(),h.x()-x,h.y()-y,h.width(),h.height(),h.solid(),h.layer())).toList(),java.util.List.of(),java.util.List.of(),Map.of("documentType","prefab"));}
+    /** Insere uma instancia independente com IDs novos e limites validados atomicamente. */
+    public static WorldDocument insert(WorldDocument d,WorldDocument prefab,int x,int y){if(prefab.elements().size()>4096)throw new IllegalArgumentException("Prefab excessivo");var layers=new ArrayList<>(d.layers());Set<String> used=new HashSet<>();prefab.elements().forEach(e->used.add(e.layer()));prefab.hitboxes().forEach(h->used.add(h.layer()));for(var l:prefab.layers())if(used.contains(l.id())){var same=layers.stream().filter(a->a.id().equals(l.id())).findFirst();if(same.isPresent()){if(same.get().role()!=l.role())throw new IllegalArgumentException("Papel de camada conflitante");EditorOperations.editable(d,l.id());}else layers.add(new WorldDocument.Layer(l.id(),l.name(),l.role(),layers.size(),true,false));}var elements=new ArrayList<>(d.elements());for(var e:prefab.elements())elements.add(new WorldDocument.Element(EditorOperations.id(),e.kind(),e.asset(),e.sha(),e.crop(),e.x()+x,e.y()+y,e.width(),e.height(),e.layer(),e.visible(),e.locked(),e.reference(),e.direction(),e.properties()));var boxes=new ArrayList<>(d.hitboxes());for(var h:prefab.hitboxes())boxes.add(new WorldDocument.Hitbox(EditorOperations.id(),h.x()+x,h.y()+y,h.width(),h.height(),h.solid(),h.layer()));return new WorldDocument(1,d.id(),d.name(),d.region(),d.width(),d.height(),d.grid(),layers,elements,boxes,d.portals(),d.triggers(),d.metadata());}
+    /** Miniatura tecnica em memoria; nenhuma imagem original e regravada. */
+    public static BufferedImage preview(WorldDocument d,AssetImages images){BufferedImage image=new BufferedImage(160,128,2);var g=image.createGraphics();try{g.setColor(new Color(30,45,40));g.fillRect(0,0,160,128);g.scale(Math.min(160d/d.width(),128d/d.height()),Math.min(160d/d.width(),128d/d.height()));g.setRenderingHint(RenderingHints.KEY_INTERPOLATION,RenderingHints.VALUE_INTERPOLATION_NEAREST_NEIGHBOR);for(var l:d.orderedLayers())for(var e:d.elements())if(e.layer().equals(l.id())){var src=images.peek(e.asset());var c=e.crop();if(src!=null)g.drawImage(src,e.x(),e.y(),e.x()+e.width(),e.y()+e.height(),c.x(),c.y(),c.x()+c.width(),c.y()+c.height(),null);else{g.setColor(Color.CYAN);g.drawRect(e.x(),e.y(),e.width(),e.height());}}for(var h:d.hitboxes()){g.setColor(Color.RED);g.drawRect(h.x(),h.y(),h.width(),h.height());}}finally{g.dispose();}return image;}
+}
