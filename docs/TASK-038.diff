+package com.projetok.prototype.rpg;
+
+import com.projetok.prototype.*;
+import javax.swing.*;
+import java.awt.event.*;
+import java.util.List;
+
+/** Entrada RPG explicita. A arena permanece acessivel pelo DebugLauncher original. */
+public final class RpgLauncher {
+    private RpgLauncher() { }
+    public static void main(String[] args) { SwingUtilities.invokeLater(RpgLauncher::open); }
+    static void open() {
+        RpgRuntime runtime = new RpgRuntime();
+        DebugSnapshot template = DebugWorld.demo().snapshot();
+        DebugPanel panel = new DebugPanel(() -> adapt(runtime.snapshot(), template));
+        JFrame frame = new JFrame("Spirit Gate | RPG offline");
+        frame.setContentPane(panel); frame.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
+        frame.pack(); frame.setLocationRelativeTo(null);
+        boolean[] held = new boolean[4];
+        String[] keys = {"W", "S", "A", "D"};
+        for (int i = 0; i < keys.length; i++) {
+            final int key = i;
+            for (boolean down : new boolean[]{true, false}) {
+                String id = keys[i] + down;
+                panel.getInputMap(JComponent.WHEN_IN_FOCUSED_WINDOW).put(KeyStroke.getKeyStroke((down ? "pressed " : "released ") + keys[i]), id);
+                panel.getActionMap().put(id, new AbstractAction() {
+                    public void actionPerformed(ActionEvent e) { held[key] = down; runtime.input((held[3]?1:0)-(held[2]?1:0), (held[1]?1:0)-(held[0]?1:0)); }
+                });
+            }
+        }
+        Timer timer = new Timer(33, e -> panel.repaint());
+        frame.addWindowListener(new WindowAdapter() { public void windowClosed(WindowEvent e) { timer.stop(); runtime.close(); } });
+        frame.addWindowFocusListener(new WindowAdapter() { public void windowLostFocus(WindowEvent e) { java.util.Arrays.fill(held, false); runtime.input(0, 0); } });
+        runtime.start(); timer.start(); frame.setVisible(true);
+    }
+    static DebugSnapshot adapt(com.projetok.rpg.RpgWorld.View v, DebugSnapshot t) {
+        return new DebugSnapshot(List.of(new DebugSnapshot.ActorView(1,"Viajante",v.x(),v.y(),18,100,100,true,true)),
+            List.of(new DebugSnapshot.Obstacle(380,180,120,120)),List.of(),100,100,0,false,v.ticks(),"RPG offline | WASD: explorar",1,0,0,null,
+            100,100,0,List.of(),List.of(),false,0,0,List.of(),false,List.of(),t.cryostasisHud(),t.lightningStepHud());
+    }
+}
