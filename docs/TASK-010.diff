+                runtime.setInput(new DebugInput(true, false, false, false, false));
+                for (int tick = 0; tick < 50; tick++) {
+                    runtime.advanceOneTick();
+                    states.add(runtime.snapshot());
+                }
+                runtime.setInput(DebugInput.NONE);
+            }
+        }
+        return List.copyOf(states);
+    }
