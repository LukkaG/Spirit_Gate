+package com.projetok.rpg;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+class BossEncounterTest {
+    static RpgWorld ruins() {var s=new RpgWorld().save();return RpgWorld.restore(new RpgSave(s.identity(),"ruins",650,320,s.hp(),s.xp(),s.coins(),s.inventory(),s.equipment(),s.quests(),s.flags(),s.ticks()));}
+    @Test void telegraphsThenExecutesAndNeverAttacksAfterDeath() {
+        var w=ruins();w.tick(0,0);assertEquals("PREPARE",w.snapshot().enemies().get(0).state());int hp=w.save().hp();
+        for(int i=0;i<29;i++)w.tick(0,0);assertEquals(hp,w.save().hp());w.tick(0,0);assertTrue(w.save().hp()<hp);
+        w.awardExperience(3600);for(int i=0;i<12&&w.snapshot().enemies().get(0).hp()>0;i++){w.attack();for(int t=0;t<12;t++)w.tick(0,0);}
+        assertEquals(0,w.snapshot().enemies().get(0).hp());assertTrue(w.save().flags().contains("boss-defeated"));
+        long xp=w.save().xp();hp=w.save().hp();for(int t=0;t<180;t++)w.tick(0,0);assertEquals(hp,w.save().hp());assertEquals(xp,w.save().xp());
+    }
+}
