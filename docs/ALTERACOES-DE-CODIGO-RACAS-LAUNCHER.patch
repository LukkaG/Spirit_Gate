diff --git a/tools/compile-local.ps1 b/tools/compile-local.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..7ff73bfc50b93c94b8402d81bb1c6967af684ab6
--- /dev/null
+++ b/tools/compile-local.ps1
@@ -0,0 +1,112 @@
+<# Compila o cliente desktop e o World Studio a partir das fontes locais, sem Maven ou rede. #>
+[CmdletBinding()]
+param([string]$JavaHome = '', [switch]$Force, [switch]$PassThru)
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+$project = [IO.Path]::GetFullPath((Join-Path $PSScriptRoot '..'))
+$buildRoot = Join-Path $project 'server\target\launcher'
+$classes = Join-Path $buildRoot 'classes'
+$sourceRoot = Join-Path $project 'server\src\main\java'
+$resourceRoot = Join-Path $project 'server\src\main\resources'
+
+function Assert-BuildPath([string]$path) {
+    $absolute = [IO.Path]::GetFullPath($path)
+    $prefix = [IO.Path]::GetFullPath($buildRoot).TrimEnd('\') + '\'
+    if (-not $absolute.StartsWith($prefix, [StringComparison]::OrdinalIgnoreCase)) {
+        throw "Saida de compilacao fora da pasta permitida: $absolute"
+    }
+    if (Test-Path -LiteralPath $absolute) {
+        if ((Get-Item -LiteralPath $absolute -Force).Attributes -band [IO.FileAttributes]::ReparsePoint) {
+            throw "Saida de compilacao nao pode ser um link: $absolute"
+        }
+    }
+    return $absolute
+}
+
+if (-not $JavaHome) { $JavaHome = $env:JAVA_HOME }
+if ($JavaHome) {
+    $jdkBin = Join-Path ([IO.Path]::GetFullPath($JavaHome)) 'bin'
+} else {
+    $compiler = Get-Command javac.exe -ErrorAction SilentlyContinue
+    if (-not $compiler) { throw 'Instale um JDK 17 ou superior e configure JAVA_HOME ou javac no PATH.' }
+    $jdkBin = Split-Path -Parent $compiler.Source
+}
+$java = Join-Path $jdkBin 'java.exe'
+$javac = Join-Path $jdkBin 'javac.exe'
+if (-not (Test-Path -LiteralPath $java -PathType Leaf) -or -not (Test-Path -LiteralPath $javac -PathType Leaf)) {
+    throw "JDK incompleto em $jdkBin. Sao necessarios java.exe e javac.exe (17 ou superior)."
+}
+$compilerVersion = (& $javac --version | Out-String).Trim()
+if ($LASTEXITCODE -ne 0 -or $compilerVersion -notmatch '^javac (\d+)') { throw 'Nao foi possivel verificar a versao do JDK.' }
+if ([int]$Matches[1] -lt 17) { throw 'O launcher exige um JDK 17 ou superior.' }
+
+$sources = @(Get-ChildItem -LiteralPath $sourceRoot -Recurse -File -Filter '*.java' | Sort-Object FullName)
+$resources = @(Get-ChildItem -LiteralPath $resourceRoot -Recurse -File | Sort-Object FullName)
+if (-not $sources.Count) { throw 'Nenhuma fonte Java encontrada.' }
+$fingerprintLines = @('compile-local-v2', '--release=17', $javac, $compilerVersion)
+foreach ($file in @($sources) + @($resources)) {
+    $relative = $file.FullName.Substring($project.Length + 1).Replace('\', '/')
+    $fingerprintLines += $relative + ':' + (Get-FileHash -LiteralPath $file.FullName -Algorithm SHA256).Hash
+}
+$sha = [Security.Cryptography.SHA256]::Create()
+try {
+    $fingerprint = [BitConverter]::ToString($sha.ComputeHash([Text.Encoding]::UTF8.GetBytes(($fingerprintLines -join "`n")))).Replace('-', '').ToLowerInvariant()
+} finally { $sha.Dispose() }
+$manifestFile = Join-Path $buildRoot 'build.json'
+$needsBuild = $true
+if (-not $Force -and (Test-Path -LiteralPath $manifestFile -PathType Leaf) -and
+    (Test-Path -LiteralPath (Join-Path $classes 'com\projetok\prototype\rpg\RpgLauncher.class') -PathType Leaf)) {
+    try {
+        $manifest = Get-Content -LiteralPath $manifestFile -Raw | ConvertFrom-Json
+        $needsBuild = $manifest.fingerprint -ne $fingerprint
+        if (-not $needsBuild) {
+            foreach ($entry in $manifest.files) {
+                $output = Assert-BuildPath (Join-Path $classes $entry.path)
+                if (-not (Test-Path -LiteralPath $output -PathType Leaf) -or
+                    (Get-FileHash -LiteralPath $output -Algorithm SHA256).Hash -ne $entry.sha256) {
+                    $needsBuild = $true
+                    break
+                }
+            }
+        }
+    } catch { $needsBuild = $true }
+}
+if ($needsBuild) {
+    New-Item -ItemType Directory -Path $buildRoot -Force | Out-Null
+    $staging = Assert-BuildPath (Join-Path $buildRoot ('compile-' + [Guid]::NewGuid().ToString('N')))
+    New-Item -ItemType Directory -Path $staging | Out-Null
+    $argumentsFile = Assert-BuildPath (Join-Path $buildRoot ('sources-' + [Guid]::NewGuid().ToString('N') + '.args'))
+    try {
+        $sourceArguments = @($sources | ForEach-Object { '"' + $_.FullName.Replace('\', '/') + '"' })
+        [IO.File]::WriteAllLines($argumentsFile, $sourceArguments, (New-Object Text.UTF8Encoding($false)))
+        Write-Host "[Spirit Gate] Compilando $($sources.Count) fontes para Java 17..."
+        & $javac --release 17 -encoding UTF-8 -d $staging ('@' + $argumentsFile)
+        if ($LASTEXITCODE -ne 0) { throw 'Compilacao falhou; o launcher nao usara classes antigas.' }
+        foreach ($file in $resources) {
+            $destination = Join-Path $staging $file.FullName.Substring($resourceRoot.Length + 1)
+            New-Item -ItemType Directory -Path (Split-Path -Parent $destination) -Force | Out-Null
+            Copy-Item -LiteralPath $file.FullName -Destination $destination
+        }
+        $inventory = @(Get-ChildItem -LiteralPath $staging -Recurse -File | Sort-Object FullName | ForEach-Object {
+            [ordered]@{ path = $_.FullName.Substring($staging.Length + 1).Replace('\', '/'); sha256 = (Get-FileHash -LiteralPath $_.FullName -Algorithm SHA256).Hash }
+        })
+        $previous = Assert-BuildPath (Join-Path $buildRoot ('previous-' + [Guid]::NewGuid().ToString('N')))
+        $safeClasses = Assert-BuildPath $classes
+        if (Test-Path -LiteralPath $safeClasses) { Move-Item -LiteralPath $safeClasses -Destination $previous }
+        try { Move-Item -LiteralPath $staging -Destination $safeClasses }
+        catch {
+            if (Test-Path -LiteralPath $previous) { Move-Item -LiteralPath $previous -Destination $safeClasses }
+            throw
+        }
+        if (Test-Path -LiteralPath $previous) { Remove-Item -LiteralPath (Assert-BuildPath $previous) -Recurse -Force }
+        $manifest = [ordered]@{ schemaVersion = 1; fingerprint = $fingerprint; java = $compilerVersion; sources = $sources.Count; files = $inventory }
+        [IO.File]::WriteAllText($manifestFile, ($manifest | ConvertTo-Json -Depth 5), (New-Object Text.UTF8Encoding($false)))
+    } finally {
+        if (Test-Path -LiteralPath $argumentsFile) { Remove-Item -LiteralPath (Assert-BuildPath $argumentsFile) -Force }
+        if (Test-Path -LiteralPath $staging) { Remove-Item -LiteralPath (Assert-BuildPath $staging) -Recurse -Force }
+    }
+}
+if ($PassThru) {
+    [pscustomobject]@{ Classes = $classes; Java = $java; JdkBin = $jdkBin; Fingerprint = $fingerprint; Rebuilt = $needsBuild }
+} else { Write-Host "[Spirit Gate] Cliente atualizado: $classes" }
diff --git a/tools/gerar_pdf_dominios.py b/tools/gerar_pdf_dominios.py
new file mode 100644
index 0000000000000000000000000000000000000000..920e11d7354ce59b0f0ea090adb153ca81a6ac4c
--- /dev/null
+++ b/tools/gerar_pdf_dominios.py
@@ -0,0 +1,100 @@
+"""Gera o PDF das decisões de raças e domínios a partir do Markdown correspondente."""
+from pathlib import Path
+import re
+from xml.sax.saxutils import escape
+
+from reportlab.lib import colors
+from reportlab.lib.enums import TA_LEFT
+from reportlab.lib.styles import ParagraphStyle, getSampleStyleSheet
+from reportlab.lib.pagesizes import A4
+from reportlab.platypus import (
+    SimpleDocTemplate, Paragraph, Spacer, Table, TableStyle, PageBreak,
+)
+
+ROOT = Path(__file__).resolve().parents[1]
+SOURCE = ROOT / 'docs/SISTEMA-DE-RACAS-E-DOMINIOS.md'
+OUTPUT = ROOT / 'docs/Spirit_Gate_Racas_e_Dominios.pdf'
+INK = colors.HexColor('#18283B')
+ACCENT = colors.HexColor('#167A87')
+
+
+def generate():
+    styles = getSampleStyleSheet()
+    styles.add(ParagraphStyle(name='BodySG', fontName='Helvetica', fontSize=9.4,
+                              leading=13.4, textColor=INK, spaceAfter=7))
+    styles.add(ParagraphStyle(name='TitleSG', parent=styles['BodySG'],
+                              fontName='Helvetica-Bold', fontSize=31, leading=36,
+                              spaceAfter=13))
+    styles.add(ParagraphStyle(name='HeadingSG', parent=styles['BodySG'],
+                              fontName='Helvetica-Bold', fontSize=18, leading=23,
+                              textColor=ACCENT, spaceAfter=13))
+    styles.add(ParagraphStyle(name='SubheadingSG', parent=styles['BodySG'],
+                              fontName='Helvetica-Bold', fontSize=11, leading=15,
+                              spaceBefore=7, spaceAfter=6, keepWithNext=True))
+    styles.add(ParagraphStyle(name='CellSG', parent=styles['BodySG'],
+                              fontSize=8.6, leading=11.6, spaceAfter=0))
+    styles.add(ParagraphStyle(name='HeaderCellSG', parent=styles['CellSG'],
+                              fontName='Helvetica-Bold', textColor=colors.white))
+    story = []
+    lines = SOURCE.read_text(encoding='utf-8').splitlines()
+    i = 0
+    while i < len(lines):
+        line = lines[i].strip()
+        i += 1
+        if not line:
+            continue
+        if line == '---':
+            story.append(PageBreak())
+        elif line.startswith('|'):
+            rows = [line]
+            while i < len(lines) and lines[i].strip().startswith('|'):
+                rows.append(lines[i].strip())
+                i += 1
+            cells = [[c.strip() for c in row.strip('|').split('|')] for row in rows]
+            cells = [row for row in cells if not all(re.fullmatch(r':?-+:?', cell) for cell in row)]
+            data = [[Paragraph(escape(cell), styles['HeaderCellSG' if n == 0 else 'CellSG'])
+                     for cell in row] for n, row in enumerate(cells)]
+            widths = [110, 389] if len(cells[0]) == 2 else [68, 210, 221]
+            table = Table(data, colWidths=widths, repeatRows=1, hAlign='LEFT')
+            table.setStyle(TableStyle([
+                ('BACKGROUND', (0, 0), (-1, 0), INK),
+                ('ROWBACKGROUNDS', (0, 1), (-1, -1),
+                 [colors.HexColor('#EDF4F5'), colors.HexColor('#F7F9FB')]),
+                ('VALIGN', (0, 0), (-1, -1), 'TOP'),
+                ('LEFTPADDING', (0, 0), (-1, -1), 8),
+                ('RIGHTPADDING', (0, 0), (-1, -1), 8),
+                ('TOPPADDING', (0, 0), (-1, -1), 7),
+                ('BOTTOMPADDING', (0, 0), (-1, -1), 7),
+            ]))
+            story.extend([table, Spacer(1, 9)])
+        elif line.startswith('# '):
+            story.append(Paragraph(escape(line[2:]), styles['TitleSG']))
+        elif line.startswith('## '):
+            story.append(Paragraph(escape(line[3:]), styles['HeadingSG']))
+        elif line.startswith('### '):
+            story.append(Paragraph(escape(line[4:]), styles['SubheadingSG']))
+        else:
+            story.append(Paragraph(escape(line), styles['BodySG']))
+
+    def decorate(canvas, doc):
+        canvas.saveState()
+        canvas.setStrokeColor(ACCENT)
+        canvas.setLineWidth(2)
+        canvas.line(48, 806, 547, 806)
+        canvas.setFont('Helvetica', 8)
+        canvas.setFillColor(INK)
+        canvas.drawString(48, 819, 'SPIRIT GATE  /  DOCUMENTO DE DESIGN')
+        canvas.drawString(48, 27, 'Raças, estilos e domínios • v1.1 • 21/10/2026')
+        canvas.drawRightString(547, 27, str(doc.page))
+        canvas.restoreState()
+
+    doc = SimpleDocTemplate(str(OUTPUT), pagesize=A4, rightMargin=48,
+                            leftMargin=48, topMargin=52, bottomMargin=48,
+                            title='Spirit Gate — Raças, estilos de combate e domínios',
+                            author='Spirit Gate', subject='Decisões de design — versão 1.1')
+    doc.build(story, onFirstPage=decorate, onLaterPages=decorate)
+    print(f'PDF gerado: {OUTPUT} ({OUTPUT.stat().st_size} bytes)')
+
+
+if __name__ == '__main__':
+    generate()
diff --git a/tools/launch-local.ps1 b/tools/launch-local.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..744c3d81b0fab45a3937e88c9310eb4fab0a2a23
--- /dev/null
+++ b/tools/launch-local.ps1
@@ -0,0 +1,40 @@
+[CmdletBinding()]
+param(
+    [ValidateSet('Rpg', 'Sprites', 'Studio', 'Map')][string]$Mode = 'Rpg',
+    [string]$MapFolder = '',
+    [switch]$Geometric,
+    [switch]$BuildOnly
+)
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+try {
+    $project = [IO.Path]::GetFullPath((Join-Path $PSScriptRoot '..'))
+    Set-Location -LiteralPath $project
+    $build = & (Join-Path $PSScriptRoot 'compile-local.ps1') -PassThru
+    if ($BuildOnly) { Write-Host '[Spirit Gate] Compilacao concluida.'; exit 0 }
+    $javaArguments = @()
+    switch ($Mode) {
+        'Studio' { $entry = 'com.projetok.studio.WorldStudio'; $clientArguments = @('--project', $project) }
+        'Map' {
+            if (-not $MapFolder -or -not (Test-Path -LiteralPath $MapFolder -PathType Container)) {
+                throw 'Informe a pasta de mapa exportada: testar-mapa-rpg.cmd "pasta-exportada"'
+            }
+            $entry = 'com.projetok.studio.StudioPlaytest'
+            $clientArguments = @([IO.Path]::GetFullPath($MapFolder), $project)
+        }
+        default {
+            $entry = 'com.projetok.prototype.rpg.RpgLauncher'
+            $clientArguments = @()
+            if ($Mode -eq 'Sprites' -and -not $Geometric) {
+                $scale = if ($env:SPIRIT_GATE_SPRITE_SCALE) { $env:SPIRIT_GATE_SPRITE_SCALE } else { '0.5' }
+                $frame = if ($env:SPIRIT_GATE_FRAME_MS) { $env:SPIRIT_GATE_FRAME_MS } else { '250' }
+                $javaArguments += @("-Dspiritgate.rpg.spriteScale=$scale", "-Dspiritgate.rpg.spriteFrameMillis=$frame")
+                $clientArguments = @('--experimental-player-sprites')
+            }
+        }
+    }
+    Write-Host '[Spirit Gate] Abrindo cliente...'
+    & $build.Java @javaArguments -cp $build.Classes $entry @clientArguments
+    if ($LASTEXITCODE -ne 0) { throw "O cliente terminou com codigo $LASTEXITCODE." }
+    exit 0
+} catch { Write-Host "[Spirit Gate] ERRO: $($_.Exception.Message)" -ForegroundColor Red; exit 1 }
diff --git a/tools/run-local-tests.py b/tools/run-local-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..cd058e45966311137e4a94e213ffc73a94865971
--- /dev/null
+++ b/tools/run-local-tests.py
@@ -0,0 +1,137 @@
+"""Compile and run the Java suite with cached JUnit, without Maven or network access."""
+from __future__ import annotations
+
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import zipfile
+
+ROOT = Path(__file__).resolve().parents[1]
+CACHE = Path.home() / ".m2" / "repository"
+ARTIFACTS = (
+    "org/junit/jupiter/junit-jupiter-api/5.11.4/junit-jupiter-api-5.11.4.jar",
+    "org/junit/jupiter/junit-jupiter-engine/5.11.4/junit-jupiter-engine-5.11.4.jar",
+    "org/junit/jupiter/junit-jupiter-params/5.11.4/junit-jupiter-params-5.11.4.jar",
+    "org/junit/platform/junit-platform-commons/1.11.4/junit-platform-commons-1.11.4.jar",
+    "org/junit/platform/junit-platform-engine/1.11.4/junit-platform-engine-1.11.4.jar",
+    "org/opentest4j/opentest4j/1.3.0/opentest4j-1.3.0.jar",
+    "org/apiguardian/apiguardian-api/1.1.2/apiguardian-api-1.1.2.jar",
+)
+
+RUNNER = r'''
+import java.util.*;
+import org.junit.jupiter.engine.JupiterTestEngine;
+import org.junit.platform.engine.*;
+import org.junit.platform.engine.discovery.DiscoverySelectors;
+
+public final class LocalJunitRunner {
+    public static void main(String[] args) {
+        var configuration = new ConfigurationParameters() {
+            public Optional<String> get(String key) { return Optional.empty(); }
+            public Optional<Boolean> getBoolean(String key) { return Optional.empty(); }
+            public int size() { return 0; }
+            public Set<String> keySet() { return Set.of(); }
+        };
+        var selector = DiscoverySelectors.selectPackage(args.length == 0 ? "com.projetok" : args[0]);
+        var request = new EngineDiscoveryRequest() {
+            public <T extends DiscoverySelector> List<T> getSelectorsByType(Class<T> type) {
+                return type.isInstance(selector) ? List.of(type.cast(selector)) : List.of();
+            }
+            public <T extends DiscoveryFilter<?>> List<T> getFiltersByType(Class<T> type) { return List.of(); }
+            public ConfigurationParameters getConfigurationParameters() { return configuration; }
+        };
+        var engine = new JupiterTestEngine();
+        var descriptor = engine.discover(request, UniqueId.forEngine(engine.getId()));
+        int[] results = new int[4];
+        var listener = new EngineExecutionListener() {
+            public void executionFinished(TestDescriptor test, TestExecutionResult result) {
+                if (test.isTest()) results[0]++;
+                switch (result.getStatus()) {
+                    case SUCCESSFUL -> { if(test.isTest()) results[1]++; }
+                    case ABORTED -> { if(test.isTest()) results[2]++; }
+                    case FAILED -> {
+                        results[3]++;
+                        System.err.println("FAILED: " + test.getUniqueId());
+                        result.getThrowable().ifPresent(error -> {
+                            System.err.println(error);
+                            var trace=error.getStackTrace();
+                            for(int i=0;i<Math.min(8,trace.length);i++) System.err.println("  at " + trace[i]);
+                            if(error.getCause()!=null) System.err.println("  caused by: " + error.getCause());
+                        });
+                    }
+                }
+            }
+            public void executionSkipped(TestDescriptor test, String reason) {
+                if(test.isTest()) results[2]++;
+            }
+        };
+        engine.execute(new ExecutionRequest(descriptor, listener, configuration));
+        System.out.printf("JUnit: %d executed, %d passed, %d skipped/aborted, %d failures%n",
+            results[0], results[1], results[2], results[3]);
+        System.exit(results[3] == 0 && results[0] > 0 ? 0 : 1);
+    }
+}
+'''
+
+
+def main() -> int:
+    java = shutil.which("java")
+    javac = shutil.which("javac")
+    if not java or not javac:
+        raise RuntimeError("Java e javac 17+ devem estar no PATH.")
+    jars = [CACHE / artifact for artifact in ARTIFACTS]
+    missing = [str(jar) for jar in jars if not jar.is_file()]
+    if missing:
+        raise RuntimeError("JUnit nao esta no cache local:\n" + "\n".join(missing))
+
+    build = ROOT / "server" / "target" / "local-tests"
+    build.mkdir(parents=True, exist_ok=True)
+    run = Path(tempfile.mkdtemp(prefix="run-", dir=build))
+    dependencies = run / "dependencies"
+    dependencies.mkdir()
+    classpath = []
+    # Directory classpaths avoid Windows sandbox ZipFS failures seen when javac opens cached JARs.
+    for jar in jars:
+        destination = dependencies / jar.stem
+        destination.mkdir()
+        with zipfile.ZipFile(jar) as archive:
+            for member in archive.infolist():
+                target = (destination / member.filename).resolve()
+                if not target.is_relative_to(destination.resolve()):
+                    raise RuntimeError(f"Caminho invalido no JAR: {member.filename}")
+            archive.extractall(destination)
+        classpath.append(str(destination))
+
+    classes = run / "classes"
+    classes.mkdir()
+    runner = run / "LocalJunitRunner.java"
+    runner.write_text(RUNNER, encoding="utf-8")
+    sources = sorted((ROOT / "server" / "src" / "main" / "java").rglob("*.java"))
+    tests = sorted((ROOT / "server" / "src" / "test" / "java").rglob("*.java"))
+    arguments = run / "sources.args"
+    arguments.write_text("\n".join('"' + path.as_posix() + '"' for path in sources + tests + [runner]), encoding="utf-8")
+    print(f"Compilando {len(sources)} fontes e {len(tests)} arquivos de teste para Java 17...", flush=True)
+    compiled = subprocess.run([javac, "--release", "17", "-encoding", "UTF-8", "-cp", os.pathsep.join(classpath), "-d", str(classes), "@" + str(arguments)], cwd=ROOT)
+    if compiled.returncode:
+        return compiled.returncode
+    shutil.copytree(ROOT / "server" / "src" / "main" / "resources", classes, dirs_exist_ok=True)
+    print(f"Resultados e classes: {run}", flush=True)
+    with (run / "test-results.log").open("w", encoding="utf-8") as log:
+        process = subprocess.Popen([java, "-Djava.awt.headless=true", "-cp", os.pathsep.join([str(classes)] + classpath), "LocalJunitRunner", *sys.argv[1:]], cwd=ROOT / "server", stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, encoding="utf-8", errors="replace")
+        assert process.stdout is not None
+        for line in process.stdout:
+            print(line, end="", flush=True)
+            log.write(line)
+            log.flush()
+        return process.wait()
+
+
+if __name__ == "__main__":
+    try:
+        raise SystemExit(main())
+    except (OSError, RuntimeError) as error:
+        print(error, file=sys.stderr)
+        raise SystemExit(1)
