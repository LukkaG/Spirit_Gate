+        assertEquals(7, result.hits().get(0).damage());
+        assertTrue(dying.isDead());
+        assertEquals(0f, remaining(dead));
+        assertEquals(0f, remaining(dying));
+        assertTrue(service.update(2.5f, targets).isEmpty());
