+        assertEquals(0, cast(service, targets).hits().get(0).damage());
+        assertEquals(4, service.update(2.5f, targets).size());
+        assertEquals(120, immune.require(HealthComponent.class).current());
+        assertEquals(0f, remaining(immune));
